# Copy this file to `.env` and fill in your own values.
# Never commit `.env` or real production passwords to git.

# MySQL connection (replace with your own names — these are not real accounts)
DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_mysql_username
DB_PASSWORD=your_long_random_password_here

# Optional: comma-separated list of old passwords during a rotation window (usually leave empty)
DB_PASSWORD_FALLBACKS=

# Optional: scripts/seed.php (CLI only). Use fake addresses/passwords for documentation;
# on your machine, put real values only inside `.env`, not in this example file.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace_me_local_dev_only
